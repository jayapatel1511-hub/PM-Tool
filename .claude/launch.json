{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/Hub.Api",
        "--launch-profile",
        "http"
      ],
      "port": 5080
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api-scale",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "-c",
        "Release",
        "--project",
        "src/Hub.Api",
        "--no-launch-profile",
        "--",
        "--environment",
        "Development",
        "--urls",
        "http://localhost:5081",
        "--ConnectionStrings:Hub",
        "Host=localhost;Port=55432;Database=hub_scale;Username=hub;Maximum Pool Size=70",
        "--RateLimit:PerMinute",
        "10000000"
      ],
      "port": 5081
    }
  ]
}