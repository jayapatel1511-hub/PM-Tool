<Project>
  <!-- Code scanning in every build (§21, packet 011 FR-011): all .NET security rules, and a security finding fails the build. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('Tests'))">
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <WarningsAsErrors>$(WarningsAsErrors);CA2100;CA2300;CA2301;CA2302;CA2305;CA2311;CA2312;CA2315;CA2321;CA2322;CA2326;CA2327;CA2328;CA2329;CA2330;CA2350;CA2351;CA2352;CA2353;CA2354;CA2355;CA2356;CA2361;CA2362;CA3001;CA3002;CA3003;CA3004;CA3006;CA3007;CA3008;CA3009;CA3010;CA3011;CA3012;CA3061;CA3075;CA3076;CA3077;CA3147;CA5350;CA5351;CA5359;CA5360;CA5363;CA5364;CA5365;CA5369;CA5370;CA5371;CA5372;CA5373;CA5374;CA5379;CA5380;CA5381;CA5384;CA5385;CA5386;CA5397;CA5398;CA5399;CA5400;CA5401;CA5402;CA5403;CA5404;CA5405;EF1002</WarningsAsErrors>
  </PropertyGroup>
</Project>
