# FR-LIVE-01: the full commit SHA, passed by the compose files; builds without it say "dev".
ARG RELEASE_SHA=dev

FROM node:24-alpine AS web
WORKDIR /work
COPY web/package.json web/package-lock.json web/.npmrc web/
RUN cd web && npm ci
COPY web/ web/
# Declared after npm ci so a new SHA reuses the cached dependency layer instead of reinstalling from the registry.
ARG RELEASE_SHA
ENV VITE_HUB_BUILD=$RELEASE_SHA
RUN mkdir -p src/Hub.Api && cd web && npm run build

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /work
COPY src/ src/
COPY --from=web /work/src/Hub.Api/wwwroot/ src/Hub.Api/wwwroot/
RUN dotnet publish src/Hub.Api/Hub.Api.csproj -c Release -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0
ARG RELEASE_SHA
ENV HUB_BUILD=$RELEASE_SHA
# FR-DLV-14: the OCI revision label the release image is inspected for.
LABEL org.opencontainers.image.revision=$RELEASE_SHA
WORKDIR /app
COPY --from=build /out/ ./
ENV ASPNETCORE_URLS=http://0.0.0.0:8080
EXPOSE 8080
USER 1000:1000
ENTRYPOINT ["dotnet", "Hub.Api.dll"]
