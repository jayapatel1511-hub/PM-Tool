# Cloudflare tunnel for pm.engcalchub.com (systemd *user* unit, dedicated to PM-Tool).
# Install to ~/.config/systemd/user/ on homedev only after private origin checks pass.
[Unit]
Description=Cloudflare tunnel for pm.engcalchub.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --config /home/jaypatel04/.cloudflared/pm-tool.yml --no-autoupdate run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=192M
CPUQuota=50%
UMask=0077

[Install]
WantedBy=default.target
